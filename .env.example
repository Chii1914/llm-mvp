# Example environment variables
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

PORT=3000
NODE_ENV=development

# Generic database URL (example for MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/dbname

# MySQL specific vars (used by some services)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=dbname

# Frontend/public API URL
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Add other service-specific secrets here (API keys, tokens, etc.)
# Example:
# THIRD_PARTY_API_KEY=your_key_here